{
  "name": "cat-scratches-test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extraction corpus & harness for the Cat Scratches Safari extension.",
  "scripts": {
    "build-manifest": "node build-manifest.mjs",
    "fetch": "node fetch.mjs",
    "fetch:pilot": "node fetch.mjs --pilot",
    "run": "node run.mjs",
    "run:articles": "node run.mjs --article-like",
    "run:pilot": "node run.mjs --pilot",
    "score": "node score.mjs",
    "story-review": "node story-review.mjs",
    "regressions": "node extraction-regressions.mjs",
    "evaluate": "node --max-old-space-size=8192 evaluate.mjs",
    "evidence": "node --max-old-space-size=8192 evaluate.mjs --evidence --set all",
    "mine": "node --max-old-space-size=8192 mine-evidence.mjs",
    "seed-expected": "node --max-old-space-size=8192 seed-expected.mjs",
    "propose": "node --max-old-space-size=8192 propose.mjs",
    "adjudicate": "node adjudicate.mjs",
    "reddit": "node reddit-extractor.mjs",
    "live-review": "node live-review.mjs",
    "ab:selectors": "node ab-selectors.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^25.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
